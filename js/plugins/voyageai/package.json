{
  "name": "@genkit-ai/voyageai",
  "description": "Genkit AI framework plugin for Voyage AI embeddings and rerankers.",
  "keywords": [
    "genkit",
    "genkit-plugin",
    "genkit-embedder",
    "genkit-reranker",
    "voyage",
    "voyageai",
    "embeddings",
    "rerank",
    "ai",
    "genai",
    "generative-ai"
  ],
  "version": "0.1.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/genkit-ai/genkit.git",
    "directory": "js/plugins/voyageai"
  },
  "author": "genkit",
  "license": "Apache-2.0",
  "peerDependencies": {
    "genkit": "workspace:^"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "voyageai": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "genkit": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "check": "tsc",
    "compile": "tsup-node",
    "build:clean": "rimraf ./lib",
    "build": "pnpm build:clean && pnpm check && pnpm compile",
    "build:watch": "tsup-node --watch",
    "test": "tsx --test tests/*_test.ts",
    "test:file": "tsx --test",
    "test:live": "tsx --test tests/live_test.ts"
  }
}
